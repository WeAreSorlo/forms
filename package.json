{
  "name": "@sorlo/forms",
  "version": "0.1.0",
  "description": "Schema-driven forms for React, with nestable groups and repeaters, conditional logic, the same validation on client and server, and a schema builder",
  "keywords": [
    "react",
    "form",
    "forms",
    "form-builder",
    "schema",
    "validation",
    "conditional-logic",
    "repeater",
    "sorlo"
  ],
  "homepage": "https://github.com/WeAreSorlo/forms#readme",
  "bugs": "https://github.com/WeAreSorlo/forms/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeAreSorlo/forms.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles/*.css": "./dist/styles/*.css",
    "./styles/*.scss": "./src/styles/*.scss"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && sass --no-source-map src/styles:dist/styles",
    "prepack": "npm run build",
    "dev": "vite",
    "format": "prettier ./src --check",
    "format:fix": "prettier ./src --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version-packages": "changeset version && npm install --package-lock-only"
  },
  "author": "Levi Cole",
  "license": "MIT",
  "dependencies": {
    "i18next": "^26.7.1",
    "lodash": "^4.17.21",
    "react-i18next": "^15.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.13.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.85.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
